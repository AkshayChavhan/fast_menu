# Supabase — get these from your project's API settings
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only service role key (NEVER expose to the client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL used for generating QR codes / share links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web Push for staff phones (optional). Generate a pair once with:
#   npx web-push generate-vapid-keys
# Leave empty to disable push; the bell simply won't appear in the waiter app.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Error monitoring with Sentry (optional). Without a DSN nothing is sent.
NEXT_PUBLIC_SENTRY_DSN=
# Only for uploading source maps at build time (Vercel / CI).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Where owners reach you from the upgrade page. Leave blank to show no
# address rather than a wrong one.
NEXT_PUBLIC_SUPPORT_EMAIL=
# Digits only, with country code, e.g. 919876543210
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# Razorpay. Key id is public (it ships to the browser); the other two are not.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From the Razorpay dashboard webhook you point at
# <site>/api/payments/razorpay/webhook, subscribed to payment.captured
RAZORPAY_WEBHOOK_SECRET=

# Sentry environment in the browser. Vercel sets NEXT_PUBLIC_VERCEL_ENV for
# you; on Netlify (or anywhere else) set this instead, e.g. production.
NEXT_PUBLIC_DEPLOY_ENV=

# What the platform runs on, so /admin/usage shows the right limits.
# HOSTING_PROVIDER: vercel | netlify. HOSTING_PLAN: hobby | pro (Vercel),
# free | pro (Netlify). SUPABASE_PLAN: free | pro. Left blank, the page
# assumes the cheapest plan and says so.
HOSTING_PROVIDER=
HOSTING_PLAN=
SUPABASE_PLAN=

# GitHub Actions minutes on /admin/usage (optional). A fine-grained token
# with "Plan: read" for the account that owns the repo, and that account's
# login. GITHUB_BILLING_OWNER_KIND is "user" (default) or "org".
GITHUB_USAGE_TOKEN=
GITHUB_BILLING_OWNER=
GITHUB_BILLING_OWNER_KIND=