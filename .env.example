# Supabase — get these from your project's API settings
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only service role key (NEVER expose to the client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL used for generating QR codes / share links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web Push for staff phones (optional). Generate a pair once with:
#   npx web-push generate-vapid-keys
# Leave empty to disable push; the bell simply won't appear in the waiter app.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
